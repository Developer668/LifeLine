# Public backend served over HTTPS; use a trusted tunnel/reverse proxy
PUBLIC_BASE_URL=http://127.0.0.1:8000
RELAY_DB=relay.db
RELAY_MODE=demo
DEMO_TOKEN=replace-with-random-secret
RELAY_WORKER_TOKEN=replace-with-a-different-random-secret
RELAY_ALLOW_SIMULATION=false

# No live carrier sends without deliberately enabling both
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_NUMBER=
TWILIO_LIVE_SEND=false

# Worker runs in MoLab; for tests it can use a deterministic simulation
RELAY_API_URL=http://127.0.0.1:8000
MODEL_BASE_URL=
MODEL_NAME=openbmb/MiniCPM-o-4_5
MODEL_BEARER_TOKEN=
RELAY_WORKER_CONCURRENCY=2

# Local speech models for telephone streaming (uv sync --extra voice)
RELAY_PIPER_MODEL=
RELAY_DISPLAY_TIMEZONE=America/Los_Angeles
RELAY_ASR_ENGINE=openai
RELAY_WHISPER_MODEL=
# Optional legacy recognizer
RELAY_VOSK_MODEL=

# Bandwidth Build: phone calls and direct SMS; never commit real credentials
BANDWIDTH_CLIENT_ID=
BANDWIDTH_CLIENT_SECRET=
BANDWIDTH_ACCOUNT_ID=
BANDWIDTH_VOICE_APPLICATION_ID=
BANDWIDTH_MESSAGING_APPLICATION_ID=
BANDWIDTH_NUMBER=
BANDWIDTH_CALLBACK_SECRET=
BANDWIDTH_MAX_CALL_SECONDS=45
BANDWIDTH_LIVE_SEND=false

# Active API inference; API key remains on the gateway. Lifetime app cap cannot exceed $5.
RELAY_INFERENCE_PROVIDER=openai
OPENAI_API_KEY=
RELAY_OPENAI_FALLBACK=true
RELAY_OPENAI_BUDGET_USD=5.00
