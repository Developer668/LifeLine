# Public backend served over HTTPS; use a trusted tunnel/reverse proxy
PUBLIC_BASE_URL=http://127.0.0.1:8000
RELAY_DB=relay.db
RELAY_MODE=demo
DEMO_TOKEN=replace-with-random-secret
RELAY_WORKER_TOKEN=replace-with-a-different-random-secret

# No live carrier sends without deliberately enabling both
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_NUMBER=
TWILIO_LIVE_SEND=false

# Worker runs in MoLab; for tests it can use a deterministic simulation
RELAY_API_URL=http://127.0.0.1:8000
MODEL_BASE_URL=
MODEL_NAME=openbmb/MiniCPM-o-4_5
MODEL_BEARER_TOKEN=
RELAY_WORKER_CONCURRENCY=2
